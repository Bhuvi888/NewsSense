GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
# Preferred: comma-separated keys, used from left to right as quotas are exhausted.
GROQ_API_KEYS=your_groq_key_1,your_groq_key_2,your_groq_key_3,your_groq_key_4
# Alternatively use GROQ_API_KEY_1 through GROQ_API_KEY_4 instead of GROQ_API_KEYS.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_MODEL=openai/gpt-oss-20b
DATABASE_URL=mysql+pymysql://newsense_app:change_me@127.0.0.1:3306/newsense?charset=utf8mb4
DATABASE_SSL_CA=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
CHROMA_PERSIST_DIRECTORY=./chroma_data
VECTOR_STORE_BACKEND=chroma
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=newsense-articles-v2
AZURE_SEARCH_VECTOR_DIMENSIONS=768
CORS_ORIGINS=http://localhost:5173
